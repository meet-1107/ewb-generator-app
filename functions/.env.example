# Settings and keys for the E-Way Easy server (Cloud Function "api").
# `firebase deploy` copies this file to .env on the first run; fill in .env, not this file.
# .env stays on your computer and on Google's servers. It is never put in the app.

# --- gstinapi.in (required) ----------------------------------------------------
# Your API key from https://www.gstinapi.in → API keys (starts with gak_).
GSTINAPI_KEY=gak_your_key
# gstinapi = real e-way bills through gstinapi.in; sandbox = fake test bills.
EWB_PROVIDER=gstinapi
# true = gstinapi.in checks the bill but files nothing and charges nothing.
# Set false to go live, after a TEST- bill worked.
GSTINAPI_TEST_MODE=true

# How often a saved GSTIN's status (Active / Cancelled) is re-checked, in days (default 30; 0 = never).
# Name and address are fetched once per GSTIN and never re-bought.
# GSTIN_STATUS_TTL_DAYS=30

# --- Email codes for registration (required) ------------------------------------
# Resend (https://resend.com → API Keys → Create API Key, "Sending access").
RESEND_API_KEY=re_your_key
# onboarding@resend.dev only delivers to the email of your Resend account.
# To email everyone, verify your domain in Resend and use e.g. E-Way Easy <noreply@yourdomain.com>
EMAIL_FROM=E-Way Easy <noreply@yourdomain.com>

# --- Credits -------------------------------------------------------------------
# Credits a new account starts with (0 = every action must be paid for).
WALLET_START_CREDITS=0
# 1 credit = CREDIT_PRICE_PAISE paise (100 = ₹1).
CREDIT_PRICE_PAISE=100
CREDIT_COSTS_JSON='{"generate":10,"part_b":5,"consolidate":5,"cancel":5,"extend":5}'
CREDIT_PACKS_JSON='[100,250,500,1000,2500]'

# --- Razorpay (optional: leave empty until you have keys) ----------------------
# Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://ewb---generator.web.app/api/payments/razorpay/webhook,
# event payment_link.paid, and the same secret as here.
RAZORPAY_WEBHOOK_SECRET=

# --- Road distance (optional) ----------------------------------------------------
# Distances between PIN codes come from the Google Routes API, called as the
# function's own account: enable "Routes API" in the Google Cloud project, no key needed.
# Only set a key if you prefer one (Google Cloud console → APIs & Services → Credentials).
# GOOGLE_MAPS_API_KEY=

# OTP_PEPPER, EWB_CREDENTIALS_SECRET and WALLET_ADMIN_TOKEN are added below
# automatically on the first deploy. Keep them; do not change them later.

# --- Admin panel (https://<project>.web.app/admin/) ------------------------------
# Comma-separated emails that are always super admins (must be verified accounts).
# This is how the first admin is created; add other admins from the panel.
SUPER_ADMIN_EMAILS=
