{
  "expo": {
    "name": "E-Way Easy",
    "slug": "eway-easy",
    "version": "1.3.15",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ewayeasy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ewayeasy.app"
    },
    "android": {
      "package": "com.ewayeasy.app",
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#175B42"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f6f5ef",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0d1411"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "108144323141-jcse80gnobvegctv3io04bg22b7p9scd.apps.googleusercontent.com",
      "eas": {
        "projectId": "cdf49fb9-aeb4-425b-9b5c-9175ff536277"
      }
    }
  }
}
