{
  "expo": {
    "name": "E-Way Easy",
    "slug": "eway-easy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ewayeasy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f6f5ef",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ewayeasy.app"
    },
    "android": {
      "package": "com.ewayeasy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f6f5ef"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "108144323141-jcse80gnobvegctv3io04bg22b7p9scd.apps.googleusercontent.com",
      "eas": {
        "projectId": "cdf49fb9-aeb4-425b-9b5c-9175ff536277"
      }
    }
  }
}
