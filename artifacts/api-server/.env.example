# Copy this file to .env (same folder) and fill in your values.
# `pnpm --filter @workspace/api-server run start` loads .env automatically.
# On Cloud Run, set the same names as environment variables instead (docs/DEPLOY.md, Part 2b).
# Never commit .env: it holds secrets.

# --- gstinapi.in ------------------------------------------------------------
# Your API key from https://www.gstinapi.in → API keys (starts with gak_).
GSTINAPI_KEY=
# gstinapi = real e-way bills through gstinapi.in; sandbox = fake test bills.
EWB_PROVIDER=gstinapi
# true = gstinapi.in validates but files nothing and charges nothing. Set false to go live.
GSTINAPI_TEST_MODE=true

# --- Security ---------------------------------------------------------------
# Long random string; encrypts each GSTIN's e-way bill portal password. Do not change it later.
EWB_CREDENTIALS_SECRET=
# Firebase project ID; when set, every request needs a signed-in user.
FIREBASE_PROJECT_ID=ewb---generator

# --- Email OTP registration -------------------------------------------------
# Resend (https://resend.com) API key and a sender on a domain you verified there.
# First test: EMAIL_FROM="E-Way Easy <onboarding@resend.dev>" (delivers to your own Resend email only).
RESEND_API_KEY=
EMAIL_FROM=E-Way Easy <verify@yourdomain.com>
# Long random secret used to hash codes (e.g. `openssl rand -hex 32`). Do not change it often.
OTP_PEPPER=
# Firebase Admin credentials for marking accounts verified:
# on Cloud Run the service account is used automatically; on your PC point this at a
# service-account JSON (Firebase console > Project settings > Service accounts > Generate key).
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\ewb-generator-admin.json

# --- Wallet & credits -------------------------------------------------------
# Credits a new account starts with (0 = every action must be paid for).
WALLET_START_CREDITS=0
# Credits per action. Defaults: generate 10, Part-B 5, consolidate 5, cancel 5, extend 5.
# CREDIT_COSTS_JSON={"generate":10,"part_b":5,"consolidate":5,"cancel":5,"extend":5}
# Long random string; lets you add credits with POST /api/admin/wallet/topup.
WALLET_ADMIN_TOKEN=

# --- Buying credits (Razorpay) ----------------------------------------------
# 1 credit = CREDIT_PRICE_PAISE paise (100 = ₹1).
CREDIT_PRICE_PAISE=100
# Packs shown in the app.
CREDIT_PACKS_JSON=[100,250,500,1000,2500]
# From Razorpay Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks (event: payment_link.paid).
RAZORPAY_WEBHOOK_SECRET=

# --- Storage / port -----------------------------------------------------------
# DATA_DIR=./.data
# PORT=5000
